{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Restrafes Documentation",
  "description": "Documentation for Restrafes products and services.",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#64748B"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/brand-logo-black.png",
    "dark": "/logo/brand-logo.png",
    "href": "/"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "go"],
      "prefill": true,
      "autogenerate": true
    },
    "mdx": {
      "server": "https://api.restrafes.co",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "tabs": [
      {
        "tab": "XCS",
        "icon": "/logo/xcs-symbol.svg",
        "groups": [
          {
            "group": "Fundamentals",
            "icon": "compass",
            "pages": ["guides/platform-overview", "guides/core-concepts"]
          },
          {
            "group": "Guides",
            "icon": "book-open",
            "pages": [
              "guides/getting-started",
              "guides/creating-an-account",
              "guides/setting-up-your-organization",
              "guides/linking-your-accounts",
              "guides/exploring-the-dashboard",
              "guides/location-setup"
            ]
          },
          {
            "group": "Integration",
            "icon": "radio",
            "pages": [
              "guides/security",
              "guides/remote-unlock-setup",
              "guides/telephone-entry"
            ]
          },
          {
            "group": "Developer APIs",
            "icon": "square-terminal",
            "pages": ["api/overview", "api/callbox"]
          },
          {
            "group": "MCP",
            "icon": "plug",
            "pages": ["mcp/overview", "mcp/connecting", "mcp/tools"]
          }
        ]
      },
      {
        "tab": "Consumer API",
        "icon": "code",
        "groups": [
          {
            "group": "API Documentation",
            "icon": "book-open",
            "pages": ["api/consumer-overview", "api/organization-api-keys", "api/get-connection"]
          },
          {
            "group": "Identities",
            "icon": "users",
            "pages": [
              "api/identities",
              "api/list-identities",
              "api/get-identity",
              "api/create-identity",
              "api/update-identity",
              "api/invite-identity",
              "api/withdraw-identity-invitation",
              "api/remove-identity"
            ]
          },
          {
            "group": "Identity Access Groups",
            "icon": "users-round",
            "pages": [
              "api/list-access-groups",
              "api/add-identity-access-groups",
              "api/remove-identity-access-groups"
            ]
          },
          {
            "group": "Access Points",
            "icon": "door-closed",
            "pages": [
              "api/list-access-points",
              "api/get-access-point",
              "api/create-access-point",
              "api/access-points"
            ]
          },
          {
            "group": "Access Point Permissions",
            "icon": "key-round",
            "pages": [
              "api/access-point-permissions",
              "api/add-access-point-permissions",
              "api/remove-access-point-permissions"
            ]
          },
          {
            "group": "Actions",
            "icon": "zap",
            "pages": ["api/remote-unlock"]
          }
        ]
      },
      {
        "tab": "Hera",
        "icon": "building-2",
        "hidden": true,
        "groups": [
          {
            "group": "Start here",
            "icon": "rocket",
            "pages": [
              "hera/overview",
              "hera/getting-started"
            ]
          },
          {
            "group": "Build and test",
            "icon": "layers",
            "pages": [
              "hera/model-structure",
              "hera/adding-floors",
              "hera/testing"
            ]
          },
          {
            "group": "Customize",
            "icon": "settings-2",
            "pages": [
              "hera/configuration/overview",
              "hera/configuration/motion",
              "hera/configuration/doors",
              "hera/configuration/buttons",
              "hera/configuration/sound-and-voice",
              "hera/configuration/indicators"
            ]
          },
          {
            "group": "Extensions",
            "icon": "puzzle",
            "pages": [
              "hera/extensions/getting-started",
              "hera/extensions/floor-lockouts",
              "hera/extensions/controller"
            ]
          },
          {
            "group": "Operation",
            "icon": "between-vertical-start",
            "pages": [
              "hera/operation/dispatch-and-calls",
              "hera/operation/door-operation",
              "hera/operation/parking-and-welding"
            ]
          },
          {
            "group": "Service modes",
            "icon": "siren",
            "pages": [
              "hera/operation/fire-and-independent-service",
              "hera/operation/fire-service",
              "hera/operation/independent-service"
            ]
          },
          {
            "group": "Scripting and integrations",
            "icon": "blocks",
            "pages": [
              "hera/integration/controller-api",
              "hera/integration/group-control-and-displays",
              "hera/integration/xcs"
            ]
          },
          {
            "group": "Reference",
            "icon": "book-marked",
            "pages": [
              "hera/reference/configuration",
              "hera/reference/events",
              "hera/reference/service-api",
              "hera/reference/glossary",
              "hera/reference/troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "XCS Dashboard",
      "href": "https://xcs.restrafes.co"
    }
  }
}
